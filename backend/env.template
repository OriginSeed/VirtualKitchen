# Template for backend/.env (local development). Copy it to backend/.env, then fill in the values.
# backend/.env is git-ignored; never commit real values. In production set these as real environment
# variables instead. Format: KEY=value, no quotes, one per line. Full reference: CONFIGURATION.md

# --- Required ---
# MongoDB connection string, including the database name, e.g. mongodb+srv://USER:PASSWORD@HOST/DATABASE
MONGODB_URI=
# At least 32 random characters, e.g. the output of: openssl rand -hex 32
JWT_SECRET=
# Google OAuth client id; must match the frontend's VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# SMTP account for OTP / verification / password-reset emails
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587

# Supabase storage for images and narration audio
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- AI providers (leave blank for a provider you don't use) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPINFRA_API_KEY=

# --- Local development conveniences (never set in production) ---
SWAGGER_ENABLED=true

# --- Optional ---
# Emails promoted to ADMIN at sign-in (comma-separated)
#VK_ADMIN_EMAILS=
# Admin panel "Keys" section; needs VK_CONFIG_ENC_KEY (any passphrase) to store keys encrypted
#VK_ADMIN_SECRET_EDITING=true
#VK_CONFIG_ENC_KEY=

# --- Production only (set on the server, shown here for reference) ---
#CORS_ALLOWED_ORIGINS=https://your-frontend-domain
#RATE_LIMIT_TRUST_FORWARDED=false
