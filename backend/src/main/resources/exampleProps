# Scene anchor: one empty-scene image per recipe, sent as a reference image with every step image (default true).
#ai.visualization.scene-anchor.enabled=true

ai.provider=ollama
ai.ollama.baseUrl=http://localhost:11434
ai.ollama.chatEndpoint=/api/chat
ai.ollama.defaultModel=qwen3:8b
ai.ollama.timeoutMs=300000
# Context window: the process-generation system prompt alone is ~12K tokens. Keep this constant so the prompt cache survives.
ai.ollama.numCtx=32768
# Keeps the model (and its cached system prompt) loaded between requests.
ai.ollama.keepAlive=30m

ai.image.provider=drawthings
ai.drawthings.baseUrl=http://localhost:7860
ai.drawthings.endpoint=/sdapi/v1/txt2img
ai.drawthings.width=512
ai.drawthings.height=512
ai.drawthings.timeoutMs=300000

# AI artifact store — keeps a paid AI payload durable between the provider call that produced it
# and the dependent work that consumes it (e.g. the image upload), so a failure in that work never
# costs a second generation. See AI_ARTIFACT_STORE_DESIGN.md.
ai.artifact.enabled=${AI_ARTIFACT_ENABLED:true}
ai.artifact.max-inline-bytes=${AI_ARTIFACT_MAX_INLINE_BYTES:16000}
ai.artifact.lease-ttl-ms=${AI_ARTIFACT_LEASE_TTL_MS:120000}
ai.artifact.consumed-retention=${AI_ARTIFACT_CONSUMED_RETENTION:7d}
ai.artifact.abandoned-retention=${AI_ARTIFACT_ABANDONED_RETENTION:30d}
ai.artifact.sweeper.enabled=${AI_ARTIFACT_SWEEPER_ENABLED:true}
ai.artifact.sweeper.fixed-delay-ms=${AI_ARTIFACT_SWEEPER_FIXED_DELAY_MS:300000}
ai.artifact.sweeper.initial-delay-ms=${AI_ARTIFACT_SWEEPER_INITIAL_DELAY_MS:60000}
ai.artifact.sweeper.orphan-age-ms=${AI_ARTIFACT_SWEEPER_ORPHAN_AGE_MS:120000}
ai.artifact.sweeper.batch-size=${AI_ARTIFACT_SWEEPER_BATCH_SIZE:25}
ai.artifact.sweeper.max-recovery-attempts=${AI_ARTIFACT_SWEEPER_MAX_RECOVERY_ATTEMPTS:3}

# GridFS bucket backing artifact binary payloads (collections ai_artifacts.files / .chunks).
spring.data.mongodb.gridfs.bucket=${MONGODB_GRIDFS_BUCKET:ai_artifacts}

# Thread pool for the scheduled jobs (credit cycle reset, AI artifact recovery).
spring.task.scheduling.pool.size=${SCHEDULING_POOL_SIZE:2}

# --- Text-to-speech (step narration) ---
# Requires the ai.models[0..4] registry entries from application.properties; indexes 5 and 6 follow them.
# Provider selection follows the model registry: point ai.default-model.TEXT_TO_SPEECH at gemini-tts or
# local-tts (or set AI_TTS_DEFAULT_MODEL). Adding a provider = a TtsProvider bean + one ai.models[n] entry.
ai.models[5].key=gemini-tts
ai.models[5].capability=TEXT_TO_SPEECH
ai.models[5].tier=PAID
ai.models[5].provider-bean=geminiTtsProvider
ai.models[5].provider-model-id=${ai.gemini.tts.model}
ai.models[5].credit-cost=1
# USD per 1M tokens for gemini-2.5-flash-preview-tts (Google AI pricing page, checked 2026-10-04): input $0.50
# (text), output $10.00 (audio tokens). Update together with ai.gemini.tts.model.
ai.models[5].input-usd-per-million=0.5
ai.models[5].output-usd-per-million=10.0
# Used only when the user has no credits left for the paid model.
ai.models[5].fallback-model-key=local-tts
ai.models[5].enabled=true

ai.models[6].key=local-tts
ai.models[6].capability=TEXT_TO_SPEECH
ai.models[6].tier=OPEN_SOURCE
ai.models[6].provider-bean=localTtsProvider
ai.models[6].provider-model-id=${ai.local-tts.model}
ai.models[6].credit-cost=0
# Local TTS engine: no per-request cost.
ai.models[6].input-usd-per-million=0
ai.models[6].output-usd-per-million=0
ai.models[6].enabled=true

# --- DeepInfra (OpenAI-compatible) text generation: see AI_MODEL_MANAGEMENT_DESIGN.md section 24 ---
# Off unless DEEPINFRA_ENABLED=true; select it with AI_TEXT_DEFAULT_MODEL=deepinfra-deepseek-v4-flash
# (and make ai.default-model.TEXT_TO_TEXT=${AI_TEXT_DEFAULT_MODEL:gemini-flash}). The key comes only from the environment.
ai.models[7].key=deepinfra-deepseek-v4-flash
ai.models[7].capability=TEXT_TO_TEXT
ai.models[7].tier=PAID
ai.models[7].provider-bean=deepInfraAiClient
ai.models[7].provider-model-id=${ai.deepinfra.defaultModel}
ai.models[7].credit-cost=1
# USD per 1M tokens, as supplied for this integration; bump vk.ai.pricing.version when changing them.
ai.models[7].input-usd-per-million=0.20
ai.models[7].cached-input-usd-per-million=0.006
ai.models[7].output-usd-per-million=0.60
ai.models[7].fallback-model-key=ollama-qwen
ai.models[7].enabled=${DEEPINFRA_ENABLED:false}

ai.deepinfra.apiKey=${DEEPINFRA_API_KEY:}
ai.deepinfra.baseUrl=https://api.deepinfra.com
ai.deepinfra.chatEndpoint=/v1/openai/chat/completions
ai.deepinfra.defaultModel=${DEEPINFRA_MODEL:deepseek-ai/DeepSeek-V4-Flash}
ai.deepinfra.timeoutMs=120000
ai.deepinfra.reasoningEffort=${DEEPINFRA_REASONING_EFFORT:none}
ai.deepinfra.jsonSchemaEnabled=${DEEPINFRA_JSON_SCHEMA_ENABLED:true}

# --- DeepInfra image generation (FLUX.2 Klein 4B): reuses the key, base URL and timeout above ---
# Off unless DEEPINFRA_IMAGE_ENABLED=true; select it with AI_IMAGE_DEFAULT_MODEL=deepinfra-flux2-klein
# (and make ai.default-model.TEXT_TO_IMAGE=${AI_IMAGE_DEFAULT_MODEL:gemini-image}).
ai.models[8].key=deepinfra-flux2-klein
ai.models[8].capability=TEXT_TO_IMAGE
ai.models[8].tier=PAID
ai.models[8].provider-bean=deepInfraImageClient
ai.models[8].provider-model-id=${ai.deepinfra.image.model}
ai.models[8].credit-cost=2
ai.models[8].fallback-model-key=drawthings-sdxl
ai.models[8].enabled=${DEEPINFRA_IMAGE_ENABLED:false}
# Billed per image: $0.014 at 1024x1024, scaled by (width/1024) x (height/1024); bump vk.ai.pricing.version on change.
vk.ai.pricing.per-image-usd.deepinfra-flux2-klein=0.014

ai.deepinfra.image.endpoint=/v1/openai/images/generations
ai.deepinfra.image.model=${DEEPINFRA_IMAGE_MODEL:black-forest-labs/FLUX-2-klein-4b}
ai.deepinfra.image.width=1024
ai.deepinfra.image.height=1024
ai.deepinfra.image.count=1

ai.default-model.TEXT_TO_SPEECH=${AI_TTS_DEFAULT_MODEL:gemini-tts}
app.queue.ai-tts-max-depth=${AI_TTS_MAX_DEPTH:20}
app.taskpool.narration.n-threads=${NARRATION_THREADS:2}
# Gemini TTS is rate limited per minute; a throttled (429/503) request waits Retry-After (else 5s, doubling,
# capped at 45s) and retries up to 4 times instead of failing the step.
ai.request.rate-limit-max-retries=4
ai.request.rate-limit-backoff-ms=5000
ai.request.rate-limit-max-backoff-ms=45000

# Gemini speech reuses ai.gemini.api-key / base-url / chat-endpoint; only the model and voice are TTS-specific.
ai.gemini.tts.model=${AI_GEMINI_TTS_MODEL:gemini-2.5-flash-preview-tts}
ai.gemini.tts.voice=${AI_GEMINI_TTS_VOICE:Kore}
ai.gemini.tts.sample-rate-hz=24000

# Self-hosted engine speaking the OpenAI-compatible POST /v1/audio/speech contract (e.g. Kokoro-FastAPI).
ai.local-tts.base-url=${LOCAL_TTS_BASE_URL:http://localhost:8880}
ai.local-tts.speech-endpoint=${LOCAL_TTS_ENDPOINT:/v1/audio/speech}
ai.local-tts.model=${LOCAL_TTS_MODEL:kokoro}
ai.local-tts.voice=${LOCAL_TTS_VOICE:af_heart}
ai.local-tts.response-format=${LOCAL_TTS_FORMAT:wav}
ai.local-tts.timeout-ms=${LOCAL_TTS_TIMEOUT_MS:60000}
ai.local-tts.api-key=${LOCAL_TTS_API_KEY:}

# Narration: provider-independent settings and audio storage (filesystem for dev, supabase for shared deployments).
ai.narration.language-code=${NARRATION_LANGUAGE:en-US}
ai.narration.max-script-chars=1200
ai.narration.lease-ms=300000
ai.narration.failed-retry-after-ms=30000
ai.narration.storage.type=${NARRATION_STORAGE:filesystem}
ai.narration.storage.filesystem.root=${NARRATION_FS_ROOT:./data/narrations}
ai.narration.storage.filesystem.public-base-url=${NARRATION_PUBLIC_BASE_URL:http://localhost:8080}
ai.narration.storage.supabase.path-prefix=narrations

# --- Logging ---
# HTTP requests at least this slow are also written to application.log (all requests go to logs/access.log).
app.logging.slow-request-ms=${SLOW_REQUEST_MS:3000}

# --- AI Recipe Creation (RecipeAiWorkflow) ---
# Relative weight of each task in the overall progress percentage (normalised over the selected tasks).
app.ai-workflow.weights.process=2
app.ai-workflow.weights.visuals=5
app.ai-workflow.weights.narration=3
# Step range assumed by the credit estimate before the recipe process has been generated.
app.ai-workflow.estimate.min-steps=6
app.ai-workflow.estimate.max-steps=20
